{
    "name": "dakiya",
    "version": "1.0.0",
    "description": "this is a chat app which provide end to end communication solution.",
    "private": true,
    "type": "module",
    "engine-strict": true,
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "client:build": "cd ./client && npm run build",
        "client:start": "cd ./client && npm start",
        "client:lint": "cd ./client && npm run lint",
        "client:test": "cd ./client && npm run test",
        "server:build": "cd ./server && npm run build",
        "server:build:prod": "cd ./server && npm run build:prod",
        "server:start": "cd ./server && npm start",
        "server:start:process": "cd ./server && npm run start:process",
        "server:lint": "cd ./server && npm run lint",
        "server:test": "cd ./server && npm run test",
        "utils:build": "cd ./packages/utils && npm run build",
        "schemas:build": "cd ./packages/schemas && npm run build",
        "build": "concurrently --kill-others \"npm run server:build\" \"npm run client:build\"",
        "build:prod": "concurrently --kill-others \"npm run server:build:prod\" \"npm run client:build\"",
        "lint": "concurrently --kill-others \"npm run server:lint\" \"npm run client:lint\"",
        "start": "concurrently --kill-others \"npm run server:start\" \"npm run client:start\"",
        "reinstall": "rm -rf node_modules && rm -f package-lock.json && npm install && npm audit fix && npm run utils:build && npm run schemas:build",
        "update": "ncu -u -x \"@dakiya/*\" && npm run reinstall"
    },
    "workspaces": [
        "client",
        "server",
        "packages/*"
    ],
    "dependencies": {
        "@dakiya/utils": "^1.0.0",
        "@dakiya/schemas": "^1.0.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@nats-io/jetstream": "^3.4.0",
        "@nats-io/kv": "^3.4.0",
        "@nats-io/transport-node": "^3.4.0",
        "fastify": "^5.12.4",
        "fastify-plugin": "^6.0.0",
        "jws": "^4.0.1",
        "mime": "^4.1.0",
        "nodemailer": "^10.0.7",
        "postgres": "^3.4.9",
        "typebox": "^1.3.30",
        "uuid": "^14.0.2",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@op-engineering/op-sqlite": "^18.2.1",
        "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
        "@types/jws": "^3.2.11",
        "@types/node": "^26.5.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.1",
        "concurrently": "^10.0.5",
        "esbuild": "^0.28.2",
        "esbuild-plugin-tailwindcss": "^2.2.0",
        "eslint": "^10.10.0",
        "npm-check-updates": "^23.1.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild": true
    },
    "keywords": [
        "chat",
        "call"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pawankr101/Dakiya.git"
    },
    "homepage": "https://github.com/pawankr101/Dakiya#readme",
    "bugs": {
        "url": "https://github.com/pawankr101/Dakiya/issues"
    },
    "author": {
        "name": "Akshay Kumar",
        "email": "pawan.akshaykr@gmail.com"
    },
    "contributors": [
        {
            "name": "Akshay Kumar",
            "email": "pawan.akshaykr@gmail.com"
        }
    ],
    "license": "ISC"
}
